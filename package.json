{
  "name": "humearth",
  "private": true,
  "version": "0.0.1",
  "description": "Hum: see how much water, air and power AI uses, as your own little living world.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:tokens -- --check && npm run build:data && tsc --noEmit && vite build",
    "build:data": "tsx scripts/build-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:tokens": "tsx scripts/build-tokens.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "test:e2e": "playwright test",
    "checklist": "tsx scripts/source-checklist.ts",
    "check:countries": "tsx scripts/check-countries.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "d3-geo": "^3.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1"
  }
}
